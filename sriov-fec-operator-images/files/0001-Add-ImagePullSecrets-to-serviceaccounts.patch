From c705137afff2121855624a4ed22c90ceb657b05c Mon Sep 17 00:00:00 2001
From: Nidhi Shivashankara Belur <nidhi.shivashankara.belur@intel.com>
Date: Mon, 26 Sep 2022 15:09:09 +0000
Subject: [PATCH] Add ImagePullSecrets to serviceaccounts

---
 sriov-fec/assets/100-labeler.yaml       | 2 ++
 sriov-fec/assets/200-device-plugin.yaml | 2 ++
 sriov-fec/assets/300-daemon.yaml        | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/sriov-fec/assets/100-labeler.yaml b/sriov-fec/assets/100-labeler.yaml
index 43f7d09..b4a08c7 100644
--- a/sriov-fec/assets/100-labeler.yaml
+++ b/sriov-fec/assets/100-labeler.yaml
@@ -28,6 +28,8 @@ data:
 ---
 apiVersion: v1
 kind: ServiceAccount
+imagePullSecrets:
+  - name: "{{ .SRIOV_FEC_IMAGE_PULL_SECRET }}"
 metadata:
   name: accelerator-discovery
   namespace: "{{ .SRIOV_FEC_NAMESPACE }}"
diff --git a/sriov-fec/assets/200-device-plugin.yaml b/sriov-fec/assets/200-device-plugin.yaml
index 3e3cd09..94d381f 100644
--- a/sriov-fec/assets/200-device-plugin.yaml
+++ b/sriov-fec/assets/200-device-plugin.yaml
@@ -3,6 +3,8 @@
 
 apiVersion: v1
 kind: ServiceAccount
+imagePullSecrets:
+  - name: "{{ .SRIOV_FEC_IMAGE_PULL_SECRET }}"
 metadata:
   name: sriov-device-plugin
   namespace: "{{ .SRIOV_FEC_NAMESPACE }}"
diff --git a/sriov-fec/assets/300-daemon.yaml b/sriov-fec/assets/300-daemon.yaml
index 1f9b1a4..005d72a 100644
--- a/sriov-fec/assets/300-daemon.yaml
+++ b/sriov-fec/assets/300-daemon.yaml
@@ -3,6 +3,8 @@
 
 apiVersion: v1
 kind: ServiceAccount
+imagePullSecrets:
+  - name: "{{ .SRIOV_FEC_IMAGE_PULL_SECRET }}"
 metadata:
   name: sriov-fec-daemon
   namespace: "{{ .SRIOV_FEC_NAMESPACE }}"
-- 
2.25.1

