From 335e8e65e6ba81d3ab783385fabb5779b77f217a Mon Sep 17 00:00:00 2001
From: Balendu Mouli Burla <balendu.burla@intel.com>
Date: Wed, 19 Nov 2025 16:39:18 +0000
Subject: [PATCH] SCSY-212149 Update kmod package version

kmod package version set to 28.11

Signed-off-by: Balendu Mouli Burla <balendu.burla@intel.com>
---
 Dockerfile.daemon | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Dockerfile.daemon b/Dockerfile.daemon
index 00c45ea..147a501 100644
--- a/Dockerfile.daemon
+++ b/Dockerfile.daemon
@@ -26,7 +26,7 @@ RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GO111MODULE=on go build -a -o sriov_fe
 FROM registry.access.redhat.com/ubi9/ubi:9.5-1736404036 AS package_installer
 
 RUN yum install \
-	kmod-28-10.el9 \
+	kmod-28-11.el9 \
 	pciutils-3.7.0-7.el9 \
 	procps-ng-3.3.17-14.el9 \
 	--releasever 9 --setopt install_weak_deps=false --nodocs -y && \
-- 
2.34.1

